# Креды ДБО. Обязательны — без них сервис не стартует.
# На Railway задаются в Variables, в файл их не коммитить.
DBO_LOGIN=
DBO_PASSWORD=

# Токен доступа к прокси. PWA передаёт его в заголовке Authorization: Bearer <токен>.
# Без него прокси открыт всем, кто знает адрес.
PROXY_TOKEN=

# Разрешённые источники запросов через запятую. Пусто = разрешены любые.
ALLOWED_ORIGINS=https://turbenbaher-del.github.io

# Необязательно: SOCKS-прокси с российским IP, если банк блокирует хостинг по гео.
BANK_SOCKS=

PORT=3001
